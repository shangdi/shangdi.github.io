---
// src/components/widget/PostGraph.astro
// Graph artikel: node = post, garis = tag yang sama (dibobot IDF), warna = klaster.
// Dihitung saat build, jadi otomatis ikut update setiap ada post baru.
import { getCollection } from "astro:content";

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;

// Cari WidgetLayout.astro di folder mana pun di src/components (tanpa atur path manual)
const layouts = import.meta.glob<{ default: any }>(
	"/src/components/**/WidgetLayout.astro",
	{ eager: true },
);
const WidgetLayout = Object.values(layouts)[0]?.default;
const Wrapper = WidgetLayout ?? "div";
const wrapperClass = WidgetLayout ? className : `card-base p-4 ${className ?? ""}`;

const W = 260;
const H = 260;
const THRESH = 3; // makin kecil = makin banyak garis
const alias: Record<string, string> = {
	"cyber-security": "cyber security",
	"dns-utils": "dnsutils",
	vm: "virtual machine",
	virtualmachine: "virtual machine",
	arch: "archlinux",
	instal: "install",
	images: "image",
	"static-site": "website",
};

type GNode = {
	i: number;
	c: number;
	deg: number;
	x: number;
	y: number;
	vx: number;
	vy: number;
	title: string;
	url: string;
	tags: string[];
};

const posts = await getCollection("posts", ({ data }) =>
	import.meta.env.PROD ? !data.draft : true,
);

const nodes: GNode[] = posts.map((p, i) => ({
	i,
	c: i,
	deg: 0,
	x: 0,
	y: 0,
	vx: 0,
	vy: 0,
	title: p.data.title as string,
	url: `/posts/${p.id.replace(/\.mdx?$/, "")}/`,
	tags: [
		...new Set(
			((p.data.tags ?? []) as string[]).map((t) => {
				const k = t.trim().toLowerCase();
				return alias[k] ?? k;
			}),
		),
	],
}));
const n = nodes.length;

// Edge: tag bersama, tag langka bobotnya lebih besar
const df = new Map<string, number>();
for (const nd of nodes)
	for (const t of nd.tags) df.set(t, (df.get(t) ?? 0) + 1);

const edges: { a: number; b: number; w: number }[] = [];
for (let a = 0; a < n; a++) {
	for (let b = a + 1; b < n; b++) {
		let w = 0;
		for (const t of nodes[a].tags) {
			const d = df.get(t) ?? 0;
			if (d > 1 && nodes[b].tags.includes(t)) w += Math.log(n / d);
		}
		if (w >= THRESH) edges.push({ a, b, w });
	}
}

// Derajat + klaster (label propagation)
const adj: [number, number][][] = nodes.map(() => []);
for (const { a, b, w } of edges) {
	adj[a].push([b, w]);
	adj[b].push([a, w]);
	nodes[a].deg++;
	nodes[b].deg++;
}
for (let k = 0; k < 20; k++) {
	for (const nd of nodes) {
		const votes = new Map<number, number>();
		for (const [j, w] of adj[nd.i])
			votes.set(nodes[j].c, (votes.get(nodes[j].c) ?? 0) + w);
		let best = nd.c;
		let bw = 0;
		votes.forEach((s, c) => {
			if (s > bw + 1e-9 || (Math.abs(s - bw) < 1e-9 && c < best)) {
				best = c;
				bw = s;
			}
		});
		nd.c = best;
	}
}
const size = new Map<number, number>();
for (const nd of nodes) size.set(nd.c, (size.get(nd.c) ?? 0) + 1);
const rank = [...size.keys()].sort((a, b) => size.get(b)! - size.get(a)!);
const color = (c: number) =>
	(size.get(c) ?? 0) < 2
		? "currentColor"
		: `hsl(${(rank.indexOf(c) * 47) % 360} 65% 55%)`;

// Layout force-directed (meniru d3-force: link + many-body + gravitasi ke tengah),
// disimulasikan di ruang bebas lalu diskalakan agar pas di kotak W x H.
nodes.forEach((nd, i) => {
	const r = 10 * Math.sqrt(0.5 + i);
	const a = i * Math.PI * (3 - Math.sqrt(5));
	nd.x = r * Math.cos(a);
	nd.y = r * Math.sin(a);
});
const ITER = 300;
const decay = 1 - Math.pow(0.001, 1 / ITER);
let alpha = 1;
for (let it = 0; it < ITER; it++) {
	alpha += (0 - alpha) * decay;
	for (const e of edges) {
		const s = nodes[e.a];
		const t = nodes[e.b];
		let x = t.x + t.vx - s.x - s.vx;
		let y = t.y + t.vy - s.y - s.vy;
		const len = Math.hypot(x, y) || 1e-6;
		const f = ((len - (60 / Math.sqrt(e.w) + 10)) / len) * alpha * 0.5;
		x *= f;
		y *= f;
		const bias = s.deg / (s.deg + t.deg);
		t.vx -= x * bias;
		t.vy -= y * bias;
		s.vx += x * (1 - bias);
		s.vy += y * (1 - bias);
	}
	for (let i = 0; i < n; i++) {
		for (let j = i + 1; j < n; j++) {
			const x = nodes[j].x - nodes[i].x;
			const y = nodes[j].y - nodes[i].y;
			let l = x * x + y * y;
			if (l < 1) l = Math.sqrt(l);
			const k = (-80 * alpha) / (l || 1);
			nodes[i].vx += x * k;
			nodes[i].vy += y * k;
			nodes[j].vx -= x * k;
			nodes[j].vy -= y * k;
		}
	}
	for (const nd of nodes) {
		nd.vx += (0 - nd.x) * 0.05 * alpha;
		nd.vy += (0 - nd.y) * 0.05 * alpha;
		nd.vx *= 0.6;
		nd.vy *= 0.6;
		nd.x += nd.vx;
		nd.y += nd.vy;
	}
}

// Skala agar pas di kotak, lalu rapikan node yang saling tumpuk
const rad = (nd: GNode) => 2 + Math.sqrt(nd.deg) * 0.5;
if (n > 0) {
	const xs = nodes.map((d) => d.x);
	const ys = nodes.map((d) => d.y);
	const pad = 8;
	const minX = Math.min(...xs);
	const maxX = Math.max(...xs);
	const minY = Math.min(...ys);
	const maxY = Math.max(...ys);
	const sc = Math.min(
		(W - 2 * pad) / (maxX - minX || 1),
		(H - 2 * pad) / (maxY - minY || 1),
	);
	const cx = (minX + maxX) / 2;
	const cy = (minY + maxY) / 2;
	for (const nd of nodes) {
		nd.x = (nd.x - cx) * sc + W / 2;
		nd.y = (nd.y - cy) * sc + H / 2;
	}
	for (let p = 0; p < 40; p++) {
		for (let i = 0; i < n; i++) {
			for (let j = i + 1; j < n; j++) {
				const a = nodes[i];
				const b = nodes[j];
				let x = b.x - a.x;
				let y = b.y - a.y;
				const d = Math.hypot(x, y) || 0.01;
				const min = rad(a) + rad(b) + 0.8;
				if (d < min) {
					const m = (min - d) / 2 / d;
					x *= m;
					y *= m;
					a.x -= x;
					a.y -= y;
					b.x += x;
					b.y += y;
				}
			}
		}
	}
	for (const nd of nodes) {
		nd.x = Math.min(W - 4, Math.max(4, nd.x));
		nd.y = Math.min(H - 4, Math.max(4, nd.y));
	}
}

const here = Astro.url.pathname;
const short = (s: string) => (s.length > 24 ? `${s.slice(0, 23)}…` : s);
---

<Wrapper name="Post Graph" id="post-graph" class={wrapperClass} style={style}>
	{!WidgetLayout && <div class="font-bold mb-2">Post Graph</div>}
	<div class="pg-root">
	<div class="pg-wrap">
		<!-- data-ctrl="1": zoom pakai Ctrl+scroll. Ganti ke "0" kalau mau scroll biasa langsung zoom. -->
		<svg class="pg-svg w-full h-auto" viewBox={`0 0 ${W} ${H}`} data-ctrl="1" role="img" aria-label="Graph hubungan antar artikel">
			<g class="pg-viewport">
				{
					edges.map(({ a, b }) => (
						<line
							x1={nodes[a].x}
							y1={nodes[a].y}
							x2={nodes[b].x}
							y2={nodes[b].y}
							stroke="currentColor"
							stroke-opacity="0.18"
							stroke-width="0.7"
						/>
					))
				}
				{
					nodes.map((nd) => (
						<a href={nd.url}>
							<circle
								cx={nd.x}
								cy={nd.y}
								r={rad(nd)}
								fill={color(nd.c)}
								stroke={here.includes(nd.url) ? "currentColor" : "none"}
								stroke-width="1.5"
							/>
							<text class="pg-label" x={nd.x} y={nd.y - rad(nd) - 1.5} text-anchor="middle">{short(nd.title)}</text>
							<title>{nd.title}</title>
						</a>
					))
				}
			</g>
		</svg>
		<div class="pg-ctl">
			<button type="button" data-pg="in" aria-label="Zoom in">+</button>
			<button type="button" data-pg="out" aria-label="Zoom out">−</button>
			<button type="button" data-pg="reset" aria-label="Reset zoom">⟲</button>
		</div>
	</div>
	<div class="pg-hint">Ctrl + scroll for zooming · drag for swiping</div>
	</div>
</Wrapper>

<style>
	/* Warna teks mengikuti tema blog: hitam di light mode, putih di dark mode */
	.pg-root { color: #000; }
	:global(.dark) .pg-root,
	:global([data-theme="dark"]) .pg-root { color: #fff; }
	.pg-wrap { position: relative; }
	.pg-svg { user-select: none; cursor: grab; touch-action: auto; }
	.pg-svg:global(.pg-active) { touch-action: none; }
	.pg-svg:global(.pg-dragging) { cursor: grabbing; }
	.pg-label {
		font-size: calc(8px / var(--k, 1));
		fill: currentColor;
		stroke: none;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s;
	}
	.pg-svg:global(.pg-zoomed) .pg-label { opacity: 0.85; }
	.pg-ctl { position: absolute; top: 0; right: 0; display: flex; gap: 4px; }
	.pg-ctl button {
		width: 22px;
		height: 22px;
		border-radius: 6px;
		font-size: 14px;
		line-height: 1;
		color: inherit;
		background: color-mix(in srgb, currentColor 10%, transparent);
	}
	.pg-ctl button:hover { background: color-mix(in srgb, currentColor 22%, transparent); }
	.pg-hint { margin-top: 6px; font-size: 11px; opacity: 0.5; }
</style>

<script>
	// Zoom/pan lewat event delegation di document, jadi tetap jalan setelah transisi halaman (Swup).
	type S = { k: number; tx: number; ty: number };
	const MAX = 8;
	const states = new WeakMap<SVGSVGElement, S>();
	const get = (svg: SVGSVGElement): S => {
		let s = states.get(svg);
		if (!s) {
			s = { k: 1, tx: 0, ty: 0 };
			states.set(svg, s);
		}
		return s;
	};
	const svgOf = (t: EventTarget | null) =>
		((t as Element | null)?.closest?.("svg.pg-svg") ?? null) as SVGSVGElement | null;

	function apply(svg: SVGSVGElement) {
		const s = get(svg);
		const vb = svg.viewBox.baseVal;
		s.k = Math.min(MAX, Math.max(1, s.k));
		s.tx = Math.min(0, Math.max(vb.width - vb.width * s.k, s.tx));
		s.ty = Math.min(0, Math.max(vb.height - vb.height * s.k, s.ty));
		svg
			.querySelector("g.pg-viewport")
			?.setAttribute("transform", `translate(${s.tx} ${s.ty}) scale(${s.k})`);
		svg.style.setProperty("--k", String(s.k));
		svg.classList.toggle("pg-active", s.k > 1.01);
		svg.classList.toggle("pg-zoomed", s.k >= 2.2);
	}
	function zoomTo(svg: SVGSVGElement, nk: number, px: number, py: number) {
		const s = get(svg);
		nk = Math.min(MAX, Math.max(1, nk));
		const r = nk / s.k;
		s.tx = px - (px - s.tx) * r;
		s.ty = py - (py - s.ty) * r;
		s.k = nk;
		apply(svg);
	}
	function toUser(svg: SVGSVGElement, cx: number, cy: number) {
		const m = svg.getScreenCTM();
		if (!m) return { x: 0, y: 0 };
		const p = new DOMPoint(cx, cy).matrixTransform(m.inverse());
		return { x: p.x, y: p.y };
	}

	// Scroll mouse / pinch trackpad
	document.addEventListener(
		"wheel",
		(e) => {
			const svg = svgOf(e.target);
			if (!svg) return;
			if (svg.dataset.ctrl === "1" && !(e.ctrlKey || e.metaKey)) return;
			e.preventDefault();
			const p = toUser(svg, e.clientX, e.clientY);
			const f = Math.abs(e.deltaY) < 40 ? 0.012 : 0.0025;
			zoomTo(svg, get(svg).k * Math.exp(-e.deltaY * f), p.x, p.y);
		},
		{ passive: false },
	);

	// Drag untuk geser, dua jari untuk pinch
	const ptrs = new Map<number, { x: number; y: number }>();
	let drag: { svg: SVGSVGElement; sx: number; sy: number; moved: boolean } | null = null;
	let pinch0: { d: number; k: number } | null = null;
	let suppress = false;

	document.addEventListener("pointerdown", (e) => {
		const svg = svgOf(e.target);
		if (!svg || (e.pointerType === "mouse" && e.button !== 0)) return;
		ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
		drag = { svg, sx: e.clientX, sy: e.clientY, moved: false };
		if (ptrs.size === 2) {
			const [a, b] = [...ptrs.values()];
			pinch0 = { d: Math.hypot(a.x - b.x, a.y - b.y) || 1, k: get(svg).k };
		}
	});
	document.addEventListener("pointermove", (e) => {
		if (!drag || !ptrs.has(e.pointerId)) return;
		const prev = ptrs.get(e.pointerId)!;
		ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
		const { svg } = drag;
		if (ptrs.size === 2 && pinch0) {
			const [a, b] = [...ptrs.values()];
			const d = Math.hypot(a.x - b.x, a.y - b.y);
			const mid = toUser(svg, (a.x + b.x) / 2, (a.y + b.y) / 2);
			zoomTo(svg, (pinch0.k * d) / pinch0.d, mid.x, mid.y);
			drag.moved = true;
			return;
		}
		if (!drag.moved && Math.hypot(e.clientX - drag.sx, e.clientY - drag.sy) < 4) return;
		drag.moved = true;
		const s = get(svg);
		if (s.k <= 1.01) return;
		const m = svg.getScreenCTM();
		const f = m ? 1 / m.a : 1;
		s.tx += (e.clientX - prev.x) * f;
		s.ty += (e.clientY - prev.y) * f;
		apply(svg);
		svg.classList.add("pg-dragging");
	});
	const end = (e: PointerEvent) => {
		if (!ptrs.delete(e.pointerId)) return;
		if (ptrs.size < 2) pinch0 = null;
		if (ptrs.size === 0 && drag) {
			drag.svg.classList.remove("pg-dragging");
			if (drag.moved) {
				suppress = true; // jangan buka link kalau barusan drag
				setTimeout(() => {
					suppress = false;
				}, 0);
			}
			drag = null;
		}
	};
	document.addEventListener("pointerup", end);
	document.addEventListener("pointercancel", end);

	// Klik: blok klik setelah drag + tombol + / − / reset
	document.addEventListener(
		"click",
		(e) => {
			const t = e.target as Element | null;
			if (suppress && svgOf(t)) {
				e.preventDefault();
				e.stopPropagation();
				suppress = false;
				return;
			}
			const btn = (t?.closest?.("[data-pg]") ?? null) as HTMLElement | null;
			if (!btn) return;
			const svg = btn.closest(".pg-wrap")?.querySelector<SVGSVGElement>("svg.pg-svg");
			if (!svg) return;
			const vb = svg.viewBox.baseVal;
			const s = get(svg);
			const act = btn.dataset.pg;
			if (act === "reset") {
				s.k = 1;
				s.tx = 0;
				s.ty = 0;
				apply(svg);
			} else {
				zoomTo(svg, s.k * (act === "in" ? 1.5 : 1 / 1.5), vb.width / 2, vb.height / 2);
			}
		},
		true,
	);
</script>
